# Copiez ce fichier en ".env" (ou definissez ces variables sur votre hebergeur)
# et adaptez les valeurs. Les variables non definies utilisent les valeurs par defaut.

# --- Identite de l'operation ---
ORGANISATEUR=Keep Cool Narbonne
VILLE=Narbonne
TITRE=GTA VI Collector — Le Grand Jeu Keep Cool

# --- Identite legale (deja renseignee par defaut) ---
RAISON_SOCIALE=SARL LIMA
SIRET=520 349 275 00021
SIREN=520 349 275
ADRESSE=44 rue Demoge, 11100 Narbonne
TELEPHONE=04 58 49 11 06
EMAIL_CONTACT=narbonne@keepcool.fr

# --- Dates (a completer) ---
DATE_DEBUT=[JJ/MM/AAAA]
DATE_FIN=[JJ/MM/AAAA]
DATE_TIRAGE=[JJ/MM/AAAA]

# --- Dotation ---
NB_GAGNANTS=5            # 5 gagnants, chacun : 1 PS5 + 1 jeu GTA VI
NB_SUPPLEANTS=5

# --- Boutique ---
PRIX_TSHIRT=25 €
PRIX_TSHIRT_CENTS=2500   # prix unitaire en centimes
FRAIS_ENVOI_CENTS=350    # frais d'envoi (3,50 €)
TAILLES=S,M,L,XL,XXL
INSCRIPTIONS_OUVERTES=true

# --- Paiement Mollie ---
# Laissez vide pour le MODE DEMO (paiement simule, pour tester).
# En production : mettez votre cle (test_xxx puis live_xxx) depuis votre dashboard Mollie.
MOLLIE_API_KEY=
# URL PUBLIQUE de votre site (obligatoire pour Mollie : redirection + webhook)
BASE_URL=https://votre-domaine.fr

# --- Envoi des e-mails de confirmation (SMTP) ---
# Laissez SMTP_HOST vide pour le MODE FICHIER (l'e-mail est ecrit dans data/emails/).
# En production, renseignez votre SMTP (ex: service transactionnel ou votre boite pro).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Keep Cool Narbonne <narbonne@keepcool.fr>
MAIL_BCC=narbonne@keepcool.fr

# --- Securite admin (A CHANGER !) ---
ADMIN_PASSWORD=changez-moi-svp

PORT=3000

# --- Hebergement Railway/Render : dossier de la base sur le volume persistant ---
# Sur Railway : creez un volume monte sur /data puis mettez DATA_DIR=/data
DATA_DIR=
